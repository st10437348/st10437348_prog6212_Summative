@model CMCSSummative.Models.Claim

<h2>Submit Claim</h2>

@if (ViewData.ModelState["HoursWorked"]?.Errors?.Count > 0)
{
    <div class="alert alert-danger text-center">
        @ViewData.ModelState["HoursWorked"].Errors[0].ErrorMessage
    </div>
}
@if (TempData["ClaimInfo"] != null)
{
    <div class="alert alert-success">@TempData["ClaimInfo"]</div>
}


<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="HoursWorked">Hours Worked</label>
        <input asp-for="HoursWorked" class="form-control" id="hoursInput" type="number" step="0.25" min="0" />
    </div>

    <div class="form-group mt-2">
        <label>Hourly Rate:</label>
        <span id="hourlyRate">@ViewBag.HourlyRate</span>
    </div>

    <div class="form-group mt-2">
        <label>Total Amount:</label>
        <span id="totalAmount">0.00</span>
    </div>

    <div class="form-group mt-3">
        <label asp-for="Notes">Notes</label>
        <textarea asp-for="Notes" class="form-control" placeholder="Optional notes..."></textarea>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" name="submit" value="save" class="btn btn-success">
            Submit Claim
        </button>

        <button type="submit" name="submit" value="upload" class="btn btn-primary">
            Submit & Upload Documents
        </button>
    </div>
</form>

<a asp-action="Index" class="btn btn-secondary mt-3">Back to Dashboard</a>

@section Scripts {
    <script>
        (function(){
            var hours = document.getElementById('hoursInput');
            var rate = parseFloat('@(ViewBag.HourlyRate ?? 0)');
            var total = document.getElementById('totalAmount');

            function recalc() {
                var h = parseFloat(hours.value || 0);
                total.innerText = (h * rate).toFixed(2);

                if (h > 180) {
                    hours.classList.add('is-invalid');
                } else {
                    hours.classList.remove('is-invalid');
                }
            }

            hours.addEventListener('input', recalc);
            recalc();
        })();
    </script>
}






