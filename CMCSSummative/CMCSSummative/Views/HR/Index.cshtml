<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold">HR Dashboard</h2>
        <p class="text-muted">Welcome, <strong>@ViewBag.Username</strong></p>
    </div>

    <div class="row justify-content-center g-4">
        <div class="col-md-3">
            <a asp-action="Users" class="btn btn-primary w-100 py-3 shadow-sm d-flex flex-column align-items-center">
                <i class="fas fa-users fa-2x mb-2"></i>
                Manage Users
            </a>
        </div>

        <div class="col-md-3">
            <a asp-action="GenerateReport" class="btn btn-info w-100 py-3 shadow-sm d-flex flex-column align-items-center">
                <i class="fas fa-file-pdf fa-2x mb-2"></i>
                Generate Claims Report
            </a>
        </div>

        <div class="col-md-3">
            <form asp-controller="Home" asp-action="Logout" method="post" class="w-100">
                <button type="submit" class="btn btn-secondary w-100 py-3 shadow-sm d-flex flex-column align-items-center">
                    <i class="fas fa-sign-out-alt fa-2x mb-2"></i>
                    Logout
                </button>
            </form>
        </div>
    </div>
</div>





